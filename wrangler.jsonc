{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "weight-record",
  "compatibility_date": "2026-10-08",
  "routes": [
    {
      "pattern": "weight.shlingang.tech",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
